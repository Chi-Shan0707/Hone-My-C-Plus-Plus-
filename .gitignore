# Build directories
/build/
**/build/
**/Debug/
**/outDebug/
cmake-build-debug/

# Compiled object files, libraries and executables
*.o
*.obj
*.so
*.a
*.lib
*.dll
*.exe
*.out
*.app

# Debug files and logs
*.log
*.tmp
*.cache
*.pdb

# CMake files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
compile_commands.json

# VS Code
.vscode/

# Visual Studio
.vs/
*.vcxproj*
*.suo
*.user
*.userosscache
*.sln

# CLion/JetBrains
.idea/
*.iml

# macOS
.DS_Store

# Windows
Thumbs.db

# Temp/editors
*~
*.swp
*.swo

# Tags and indexes
tags
TAGS

# Coverage and test output
coverage/
*.gcno
*.gcda

# Python artifacts (if present)
__pycache__/
*.pyc

# Environment files - do not commit secrets
.env
.env.*

# Misc
node_modules/
npm-debug.log
yarn-error.log

# Archives
*.zip
*.tar.gz

# Extensionless binaries (common with g++ -o name)
# Not matched by extension; use .gitattributes or track explicitly

# Allow local overrides file (optional)
!.gitignore.local